{
  "name": "a2z-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist && tsx scripts/count-assets.ts && tsx scripts/check-budget.ts",
    "preview": "astro preview",
    "new": "tsx scripts/new-post.ts",
    "validate": "tsx scripts/validate-content.ts",
    "links": "linkinator dist/index.html --recurse --silent --skip '^https' --skip '/pagefind/'",
    "suggest-links": "tsx scripts/internal-links.ts",
    "stale": "tsx scripts/stale-posts.ts",
    "indexnow": "tsx scripts/indexnow.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "lhci": "lhci autorun",
    "test": "playwright test",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply a2z-skills --local",
    "db:migrate": "wrangler d1 migrations apply a2z-skills --remote",
    "budget": "tsx scripts/check-budget.ts",
    "check:worker": "wrangler types && tsc -p worker/tsconfig.json",
    "icons": "tsx scripts/make-icons.ts",
    "image": "tsx scripts/add-image.ts",
    "check": "npm run lint && npm run check:worker && npm run validate && npm run build && npm run links && npm test",
    "deploy": "npm run check && wrangler deploy",
    "mcp:deploy": "wrangler deploy --config mcp/wrangler.json",
    "mcp:dev": "wrangler dev --config mcp/wrangler.json --port 8799"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "satori": "^0.63.2",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "http-server": "^14.1.1",
    "linkinator": "^8.1.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0",
    "yaml": "^2.9.1"
  }
}
