---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/cards/PostCard.astro';
import PillarCard from '../components/cards/PillarCard.astro';
import AdSlot from '../components/money/AdSlot.astro';
import { livePosts } from '../lib/posts';
import { site } from '../site';

const posts = await livePosts();
const pillars = (await getCollection('pillars')).sort(
  (a, b) => a.data.order - b.data.order,
);
const countFor = (id: string) => posts.filter((p) => p.data.pillar === id).length;
const latest = posts.slice(0, site.postsPerPage);
const tested = posts.filter((p) => p.data.testedOn).length;
---

<BaseLayout
  title={`${site.name} — ${site.tagline}`}
  description={site.description}
  path="/"
>
  <section class="shell pt-8 pb-5 sm:pt-12">
    <p class="pill text-accent">Every guide tested on real devices</p>
    <h1 class="mt-3 max-w-3xl font-display text-[1.75rem] font-bold leading-[1.1] sm:text-4xl lg:text-5xl">
      Tech fixes that were actually tried before they were published.
    </h1>
    <p class="mt-3 max-w-2xl text-ink-soft sm:text-lg">
      Every guide lists the versions it was tested on, the device it ran on, and what went
      wrong on the way.
    </p>
    <form action="/search/" method="get" role="search" class="mt-5 flex max-w-md gap-2">
      <label class="sr-only" for="home-q">
        Search guides
      </label>
      <input
        id="home-q"
        name="q"
        type="search"
        placeholder="What is broken?"
        class="min-w-0 flex-1 rounded-pill border border-rule bg-paper px-4 py-2.5 text-base shadow-card"
      />
      <button
        type="submit"
        class="rounded-pill bg-brand-deep px-4 py-2.5 font-semibold text-paper transition-colors hover:bg-brand"
      >
        Search
      </button>
    </form>
    {tested > 0 && (
      <p class="mt-3 text-sm text-ink-faint">
        {tested} tested {tested === 1 ? 'guide' : 'guides'} so far, across {pillars.length}{' '}
        topics.
      </p>
    )}
  </section>

  <section class="shell py-5" aria-labelledby="topics">
    <h2 id="topics" class="font-display text-xl font-semibold sm:text-2xl">
      Start with a topic
    </h2>
    <div class="mt-3 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
      {pillars.map((p) => (
        <PillarCard pillar={p} count={countFor(p.id)} />
      ))}
    </div>
  </section>

  <section class="shell py-5" aria-labelledby="latest">
    <div class="flex items-baseline justify-between gap-3">
      <h2 id="latest" class="font-display text-xl font-semibold sm:text-2xl">
        Latest guides
      </h2>
      {posts.length > 0 && (
        <a href="/topics/" class="text-sm">
          All topics
        </a>
      )}
    </div>
    {latest.length === 0 ? (
      <p class="mt-3 text-ink-soft">The first guides are being tested now.</p>
    ) : (
      <div class="card mt-3 divide-y divide-rule px-3.5">
        {latest.map((p) => (
          <PostCard post={p} showPillar={true} />
        ))}
      </div>
    )}
  </section>

  <div class="shell">
    <AdSlot position="end-article" />
  </div>
</BaseLayout>
