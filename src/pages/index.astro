---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/cards/PostCard.astro';
import PillarCard from '../components/cards/PillarCard.astro';
import { livePosts } from '../lib/posts';
import { site } from '../site';

const posts = await livePosts();
const pillars = (await getCollection('pillars')).sort(
  (a, b) => a.data.order - b.data.order,
);
const countFor = (id: string) => posts.filter((p) => p.data.pillar === id).length;
const latest = posts.slice(0, site.postsPerPage);
const tested = posts.filter((p) => p.data.testedOn).length;
---

<BaseLayout
  title={`${site.name} — ${site.tagline}`}
  description={site.description}
  path="/"
>
  <section class="tint border-b border-rule">
    <div class="shell py-8 sm:py-11">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-[0.12em] text-accent">
            <span class="rule-accent"></span>
            Tested fixes and sourced explanations
          </p>
          <h1 class="mt-3 font-display text-[1.9rem] font-bold leading-[1.08] sm:text-4xl lg:text-[2.75rem]">
            Tech fixes that were <span class="marker">actually tried</span> before they were
            published.
          </h1>
          <p class="mt-3 max-w-xl text-ink-soft">
            Fixes include test records and the errors encountered. Explainers link to
            product documentation and research so you can check the reasoning.
          </p>
        </div>

        <form
          action="/search/"
          method="get"
          role="search"
          class="flex w-full gap-2 lg:w-80 lg:shrink-0"
        >
          <label class="sr-only" for="home-q">
            Search guides
          </label>
          <input
            id="home-q"
            name="q"
            type="search"
            placeholder="What is broken?"
            class="min-w-0 flex-1 rounded-pill border border-rule bg-paper px-4 py-2.5 text-base shadow-card"
          />
          <button
            type="submit"
            class="rounded-pill bg-brand-deep px-4 py-2.5 font-semibold text-paper transition-colors hover:bg-brand"
          >
            Search
          </button>
        </form>
      </div>
    </div>
  </section>

  <section class="shell py-5" aria-labelledby="latest">
    <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
      <h2 id="latest" class="font-display text-xl font-semibold sm:text-2xl">
        Latest guides
      </h2>
      {tested > 0 && (
        <p class="text-sm text-ink-faint">
          {posts.length} articles, including {tested} tested{' '}
          {tested === 1 ? 'guide' : 'guides'}
        </p>
      )}
    </div>
    {latest.length === 0 ? (
      <p class="mt-3 text-ink-soft">The first guides are being tested now.</p>
    ) : (
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {latest.map((p) => (
          <PostCard post={p} showPillar={true} />
        ))}
      </div>
    )}
  </section>

  <section class="shell py-5" aria-labelledby="topics">
    <h2 id="topics" class="font-display text-xl font-semibold sm:text-2xl">
      Start with a topic
    </h2>
    <div class="mt-3 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
      {pillars.map((p) => (
        <PillarCard pillar={p} count={countFor(p.id)} />
      ))}
    </div>
  </section>

  <div class="shell"></div>
</BaseLayout>
