---
import { getCollection } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import workbench from '../assets/illustrations/tech-workbench.webp';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import GuideLibrary from '../components/site/GuideLibrary.astro';
import { livePosts, postPath } from '../lib/posts';
import { formatDate } from '../lib/format';
import { collectionPage } from '../lib/schema';
import { site, absolute } from '../site';

const posts = await livePosts();
const pillars = (await getCollection('pillars')).sort(
  (a, b) => a.data.order - b.data.order,
);
const tested = ['automation', 'websites-hosting'].flatMap((id) => {
  const pillar = pillars.find((entry) => entry.id === id);
  const post = pillar?.data.startHere
    .map((slug) => posts.find((entry) => entry.id === slug))
    .find((entry) => entry?.data.testedOn?.testedBy);
  return post ? [post] : [];
});
const lead = tested[0];
const supporting = [
  ...tested.slice(1),
  ...posts.filter((post) => post.data.testedOn?.testedBy && !tested.includes(post)),
].slice(0, 2);
const social = await getImage({
  src: workbench,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
  quality: 82,
});
---

<BaseLayout
  title="Automation, hosting and everyday tech fixes"
  description={site.description}
  path="/"
  image={absolute(social.src)}
  imageAlt="An illustrated laptop, phone and connected cloud on a technology workbench."
>
  <JsonLd
    slot="head"
    data={collectionPage({
      name: 'A2Z Skills guides',
      description: site.description,
      path: '/',
      items: posts.map((post) => ({ name: post.data.title, path: postPath(post) })),
    })}
  />
  <div class="shell">
    <section class="border-b border-rule py-6 sm:py-8" aria-labelledby="home-title">
      <h1 id="home-title" class="font-display text-xl font-semibold sm:text-2xl">
        Practical guides for the tools you use.
      </h1>
      <p class="mt-1 text-base text-ink-soft">
        Clear explanations when something doesn’t work.
      </p>
      <form action="/search/" method="get" role="search" class="mt-4 flex gap-2 lg:hidden">
        <label class="sr-only" for="home-q">
          Search guides
        </label>
        <input
          id="home-q"
          name="q"
          type="search"
          placeholder="Tool name or error message"
          class="min-h-11 min-w-0 flex-1 rounded-soft border border-rule bg-paper px-3 text-base"
        />
        <button
          type="submit"
          class="rounded-soft bg-brand-deep px-4 font-semibold text-paper"
        >
          Search
        </button>
      </form>
    </section>
    {lead && (
      <section
        id="tested-guides"
        class="grid gap-7 border-b border-rule py-7 sm:py-9 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:gap-9"
        aria-label="Featured tested guides"
      >
        <article class="min-w-0">
          <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ink-soft">
            <span>Automation</span>
            <span class="font-semibold text-brand-deep">Tested guide</span>
            <time datetime={(lead.data.updatedAt ?? lead.data.publishedAt).toISOString()}>
              {formatDate(lead.data.updatedAt ?? lead.data.publishedAt)}
            </time>
          </p>
          <h2 class="mt-3 max-w-xl font-display text-3xl font-bold leading-tight sm:text-4xl">
            <a href={postPath(lead)} class="no-underline text-ink hover:text-brand-deep">
              {lead.data.title}
            </a>
          </h2>
          <div class="mt-4 flex gap-4 sm:gap-5">
            <div class="min-w-0 flex-1">
              <p class="text-base leading-relaxed text-ink-soft">{lead.data.description}</p>
              <a
                href={postPath(lead)}
                class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-semibold"
              >
                Read the guide <span aria-hidden="true">→</span>
              </a>
            </div>
            {lead.data.heroImage && (
              <Picture
                src={lead.data.heroImage}
                alt="A laptop showing an automation workflow connected to a cloud server."
                widths={[240, 480]}
                width={480}
                height={360}
                fit="cover"
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                sizes="(min-width: 640px) 200px, 112px"
                loading="eager"
                fetchpriority="high"
                class="w-28 shrink-0 self-start rounded-soft object-cover sm:w-48"
                data-home-art
                data-editorial-art
              />
            )}
          </div>
        </article>
        <div class="grid gap-6 border-t border-rule pt-6 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-9">
          {supporting.map((post) => (
            <article class="min-w-0">
              <p class="text-xs font-semibold text-brand-deep">
                Tested guide ·{' '}
                {post.data.pillar === 'automation' ? 'Automation' : 'Websites & hosting'}
              </p>
              <h2 class="mt-2 font-display text-xl font-semibold leading-snug sm:text-2xl">
                <a
                  href={postPath(post)}
                  class="no-underline text-ink hover:text-brand-deep"
                >
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                {post.data.description}
              </p>
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
  <GuideLibrary posts={posts} pillars={pillars} />
</BaseLayout>
