---
import BaseLayout from '../layouts/BaseLayout.astro';
import Search from '../components/site/Search.astro';
---

<BaseLayout
  title="Search"
  description="Search every tested guide on A2Z Skills by error message, tool name or task."
  path="/search/"
  noindex={true}
>
  <div class="shell max-w-3xl py-7">
    <h1 class="font-display text-[1.6rem] font-bold sm:text-3xl">Search</h1>
    <div class="mt-6">
      <Search />
    </div>
  </div>
</BaseLayout>
