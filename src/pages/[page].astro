---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { formatDate } from '../lib/format';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const pages = await getCollection('pages');
  return pages.map((page) => ({ params: { page: page.id }, props: { page } }));
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: CollectionEntry<'pages'> };
const { Content } = await render(page);
const path = `/${page.id}/`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: page.data.title, path },
];
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  path={path}
  noindex={page.data.noindex}
>
  <div class="mx-auto max-w-3xl px-gutter py-6">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-3 font-display text-3xl font-bold">{page.data.title}</h1>
    <p class="mt-2 text-sm text-ink-faint">
      Last updated{' '}
      <time datetime={page.data.updatedAt.toISOString()}>
        {formatDate(page.data.updatedAt)}
      </time>
    </p>
    <div class="prose prose-lg mt-6 max-w-measure dark:prose-invert">
      <Content />
    </div>
  </div>
</BaseLayout>
