---
import { Picture, getImage } from 'astro:assets';
import { absolute } from '../../site';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import PostCard from '../../components/cards/PostCard.astro';
import { collectionPage, breadcrumbs } from '../../lib/schema';
import { livePosts, postPath, type Post } from '../../lib/posts';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const pillars = await getCollection('pillars');
  return pillars.map((pillar) => ({ params: { pillar: pillar.id }, props: { pillar } }));
}) satisfies GetStaticPaths;

const { pillar } = Astro.props as { pillar: CollectionEntry<'pillars'> };
const { Content } = await render(pillar);
const posts = (await livePosts()).filter((p) => p.data.pillar === pillar.id);

const startHere = pillar.data.startHere
  .map((id) => posts.find((p) => p.id === id))
  .filter((p): p is Post => Boolean(p));

// Hubs group by what the reader is trying to do, not by date.
const groups: { label: string; types: string[] }[] = [
  { label: 'Fixes', types: ['fix'] },
  { label: 'How-to guides', types: ['how-to'] },
  { label: 'Comparisons and reviews', types: ['comparison', 'review'] },
  { label: 'Explainers and lists', types: ['explainer', 'list', 'asset'] },
];

const leadPost =
  startHere.find((post) => post.data.heroImage) ??
  posts.find((post) => post.data.heroImage);
const social = leadPost?.data.heroImage
  ? await getImage({
      src: leadPost.data.heroImage,
      width: 1200,
      height: 630,
      fit: 'cover',
      format: 'jpeg',
      quality: 82,
    })
  : undefined;
const path = `/topics/${pillar.id}/`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Topics', path: '/topics/' },
  { name: pillar.data.name, path },
];
---

<BaseLayout
  title={pillar.data.title}
  description={pillar.data.description}
  path={path}
  activePillar={pillar.id}
  image={social ? absolute(social.src) : undefined}
  imageAlt={leadPost?.data.heroAlt}
>
  <JsonLd
    slot="head"
    data={collectionPage({
      name: pillar.data.name,
      description: pillar.data.description,
      path,
      items: groups
        .flatMap((group) => posts.filter((post) => group.types.includes(post.data.type)))
        .map((post) => ({ name: post.data.title, path: postPath(post) })),
    })}
  />
  <JsonLd slot="head" data={breadcrumbs(crumbs)} />
  <div class="shell max-w-4xl py-5">
    <Breadcrumbs crumbs={crumbs} />
    <div class="mt-5 grid items-center gap-6 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
      <div class="min-w-0">
        <h1 class="font-display text-3xl font-bold leading-tight sm:text-4xl">
          {pillar.data.title}
        </h1>
        <div class="prose mt-4 measure dark:prose-invert">
          <Content />
        </div>
      </div>
      {leadPost?.data.heroImage && (
        <Picture
          src={leadPost.data.heroImage}
          alt=""
          widths={[480, 800]}
          width={800}
          height={640}
          fit="cover"
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          quality={75}
          sizes="(min-width: 768px) 380px, 94vw"
          loading="eager"
          class="illustration-frame aspect-[5/4] w-full object-cover"
          data-editorial-art
        />
      )}
    </div>

    {startHere.length > 0 && posts.length > 3 && (
      <section class="mt-8" aria-labelledby="start-here">
        <h2 id="start-here" class="font-display text-xl font-semibold">
          Start here
        </h2>
        <ol class="mt-3 space-y-2">
          {startHere.map((p, i) => (
            <li class="flex gap-3">
              <span class="font-mono text-ink-faint">{i + 1}</span>
              <a href={postPath(p)} class="font-medium">
                {p.data.title}
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    {posts.length === 0 ? (
      <p class="mt-7 rounded-card border border-dashed border-rule p-4 text-ink-soft">
        Guides for this topic are being tested now.
      </p>
    ) : (
      groups.map((g) => {
        const inGroup = posts.filter((p) => g.types.includes(p.data.type));
        return inGroup.length > 0 ? (
          <section class="mt-8" aria-labelledby={`g-${g.types[0]}`}>
            <h2 id={`g-${g.types[0]}`} class="font-display text-xl font-semibold">
              {g.label}
            </h2>
            <div class:list={['mt-3 grid gap-3', inGroup.length > 1 && 'sm:grid-cols-2']}>
              {inGroup.map((p) => (
                <PostCard post={p} />
              ))}
            </div>
          </section>
        ) : null;
      })
    )}
  </div>
</BaseLayout>
