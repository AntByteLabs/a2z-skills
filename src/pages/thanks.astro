---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Your address is saved"
  description="Your email address has been saved to the A2Z Skills notification list. Email delivery is not active yet."
  path="/thanks/"
  noindex={true}
>
  <div class="shell max-w-2xl py-16 text-center">
    <h1 class="font-display text-3xl font-bold">That worked.</h1>
    <p class="mt-3 text-lg text-ink-soft">
      Your address is on the notification list. Email delivery is not active yet, so there
      is no confirmation message to wait for.
    </p>
    <p class="mt-6">
      <a href="/">Back to the guides</a>
    </p>
  </div>
</BaseLayout>
