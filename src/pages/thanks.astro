---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="You are subscribed"
  description="Thanks for subscribing to A2Z Skills. One tested guide a week, and nothing else."
  path="/thanks/"
  noindex={true}
>
  <div class="shell max-w-2xl py-16 text-center">
    <h1 class="font-display text-3xl font-bold">That worked.</h1>
    <p class="mt-3 text-lg text-ink-soft">
      You will get one tested guide a week. Nothing else, and one click to stop.
    </p>
    <p class="mt-6">
      <a href="/">Back to the guides</a>
    </p>
  </div>
</BaseLayout>
