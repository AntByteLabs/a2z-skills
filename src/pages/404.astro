---
import BaseLayout from '../layouts/BaseLayout.astro';
import { livePosts } from '../lib/posts';
import { postPath } from '../lib/posts';
const recent = (await livePosts()).slice(0, 5);
---

<BaseLayout
  title="Page not found"
  description="That page does not exist on A2Z Skills. Search for what you need, or start from the latest tested guides."
  path="/404/"
  noindex={true}
>
  <div class="shell max-w-2xl py-14">
    <h1 class="font-display text-3xl font-bold">That page is not here.</h1>
    <p class="mt-3 text-ink-soft">
      It may have moved. Try the <a href="/search/">search</a>, or one of these:
    </p>
    <ul class="mt-4 space-y-1">
      {recent.map((p) => (
        <li>
          <a href={postPath(p)}>{p.data.title}</a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
