---
import '../styles/global.css';
import SEO from '../components/seo/SEO.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { website } from '../lib/schema';
import { site } from '../site';

interface Props {
  title: string;
  description: string;
  path: string;
  seoTitle?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
  ogType?: 'website' | 'article';
  wide?: boolean;
  searchable?: boolean;
  activePillar?: string;
}

const { wide = false, searchable = false, activePillar, ...seo } = Astro.props;
const configuredAnalyticsToken = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN ?? '';
const analyticsToken = /^[a-f0-9]{32}$/i.test(configuredAnalyticsToken)
  ? configuredAnalyticsToken
  : undefined;
---

<!doctype html>
<html
  lang={site.locale}
  class="scheme-light dark:scheme-dark"
  data-pagefind-ignore={searchable ? undefined : 'all'}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1b2436" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <SEO {...seo} />
    <JsonLd data={website()} />
    <!-- Theme is applied before first paint so the page never flashes. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('a2z-theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.dataset.theme = saved;
        }
      } catch {
        // Storage unavailable: fall back to the system colour scheme.
      }
    </script>
    <slot name="head" />
    <style>
      /* A guide is something people print and carry to the broken machine. */
      @media print {
        header,
        footer,
        nav,
        form,
        #reading-progress,
        [data-ad-slot],
        [data-helpful],
        [data-share],
        [data-copy-link] {
          display: none !important;
        }
        :root {
          --color-paper: #fff;
          --color-paper-sunk: #fff;
          --color-ink: #000;
          --color-ink-soft: #222;
        }
        a[href^='http']::after {
          content: ' (' attr(href) ')';
          font-size: 0.85em;
          word-break: break-all;
        }
        pre,
        blockquote,
        figure,
        table {
          break-inside: avoid;
        }
      }
    </style>
  </head>
  <body class="min-h-dvh flex flex-col bg-paper text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-paper focus:px-3 focus:py-2 focus:shadow"
    >
      Skip to content
    </a>
    <Header activePillar={activePillar} />
    <script>
      // Press / anywhere to search, the way every tool people already use does.
      addEventListener('keydown', (event) => {
        if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
        const el = document.activeElement;
        const typing =
          el instanceof HTMLInputElement ||
          el instanceof HTMLTextAreaElement ||
          (el instanceof HTMLElement && el.isContentEditable);
        if (typing) return;
        const box = document.querySelector<HTMLInputElement>('input[type="search"]');
        if (box) {
          event.preventDefault();
          box.focus();
          box.select();
        } else {
          location.href = '/search/';
        }
      });
    </script>
    <main id="main" class={wide ? 'flex-1' : 'flex-1 w-full'}>
      <slot />
    </main>
    <Footer />
    {analyticsToken && import.meta.env.PROD && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      ></script>
    )}
  </body>
</html>
