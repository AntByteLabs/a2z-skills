---
import type { MarkdownHeading } from 'astro';
import { getEntry } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import QuickAnswer from '../components/post/QuickAnswer.astro';
import TestedOn from '../components/post/TestedOn.astro';
import LastUpdated from '../components/post/LastUpdated.astro';
import Toc from '../components/post/Toc.astro';
import FAQ from '../components/post/FAQ.astro';
import Download from '../components/post/Download.astro';
import AuthorBox from '../components/post/AuthorBox.astro';
import RelatedPosts from '../components/post/RelatedPosts.astro';
import AffiliateDisclosure from '../components/money/AffiliateDisclosure.astro';
import AdSlot from '../components/money/AdSlot.astro';
import NewsletterForm from '../components/site/NewsletterForm.astro';
import ReadingProgress from '../components/post/ReadingProgress.astro';
import ReaderBar from '../components/post/ReaderBar.astro';
import CopyCode from '../components/post/CopyCode.astro';
import ShareRow from '../components/post/ShareRow.astro';
import PrevNext from '../components/post/PrevNext.astro';
import Helpful from '../components/post/Helpful.astro';
import { blogPosting, breadcrumbs, faqPage, type Crumb } from '../lib/schema';
import { relatedPosts, postPath, livePosts, type Post } from '../lib/posts';
import { absolute } from '../site';
import { pillarLabel, readingMinutes, postTypeLabel } from '../lib/format';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  /** Raw body, used only to estimate reading time. */
  body: string;
}

const { post, headings, body } = Astro.props;
const { data } = post;

const author = await getEntry(data.author);
if (!author) throw new Error(`Post ${post.id} references a missing author`);
const pillar = await getEntry('pillars', data.pillar);

const path = postPath(post);
const social = data.heroImage
  ? await getImage({
      src: data.heroImage,
      width: 1200,
      height: 630,
      fit: 'cover',
      format: 'jpeg',
      quality: 82,
    })
  : undefined;
const ogImage = social ? absolute(social.src) : absolute(`/og/${post.id}.png`);
const related = await relatedPosts(post);

// Newest first, so "previous" is the post published before this one.
const all = await livePosts();
const here = all.findIndex((p) => p.id === post.id);
const next = here > 0 ? all[here - 1] : undefined;
const prev = here >= 0 && here < all.length - 1 ? all[here + 1] : undefined;

const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: pillar?.data.name ?? pillarLabel(data.pillar), path: `/topics/${data.pillar}/` },
  { name: data.title, path },
];

const article = blogPosting({
  title: data.title,
  description: data.description,
  path,
  image: ogImage,
  publishedAt: data.publishedAt,
  updatedAt: data.updatedAt,
  author: {
    name: author.data.name,
    path: `/authors/${author.id}/`,
    sameAs: author.data.sameAs,
  },
  subject: data.type === 'review' ? { name: data.title } : undefined,
  keywords: data.tags,
  section: pillar?.data.name,
});

// Only when the FAQ is actually rendered below.
const faq = data.faq.length > 0 ? faqPage({ path, questions: data.faq }) : undefined;
---

<BaseLayout
  title={data.title}
  seoTitle={data.seoTitle}
  description={data.description}
  path={path}
  image={ogImage}
  imageAlt={data.heroAlt}
  noindex={data.noindex || data.draft}
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  ogType="article"
  searchable={true}
  activePillar={data.pillar}
  plainTextPath={`/${post.id}.txt`}
>
  <JsonLd data={article} slot="head" />
  <ReadingProgress />
  <JsonLd data={breadcrumbs(crumbs)} slot="head" />
  {faq && <JsonLd data={faq} slot="head" />}

  <div class="shell grid gap-8 py-5 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-10">
    <article class="min-w-0 lg:max-w-[42rem]" data-pagefind-body>
      <Breadcrumbs crumbs={crumbs} />

      <div data-pagefind-ignore class="mt-2.5 flex flex-wrap items-center gap-x-2 gap-y-1">
        <span class="pill">{postTypeLabel(data.type)}</span>
        {pillar && (
          <a href={`/topics/${pillar.id}/`} class="pill no-underline hover:text-ink">
            {pillar.data.name}
          </a>
        )}
      </div>

      <h1
        data-pagefind-meta="title"
        class="mt-2 font-display text-[1.6rem] font-bold leading-[1.15] sm:text-4xl"
      >
        {data.title}
      </h1>

      <div data-pagefind-ignore class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1.5">
        <a
          href={`/authors/${author.id}/`}
          class="flex items-center gap-2 text-sm font-medium no-underline hover:underline"
        >
          <img
            src={author.data.avatar}
            alt=""
            width="28"
            height="28"
            class="h-7 w-7 rounded-full bg-paper-sunk object-cover"
          />
          {author.data.name}
        </a>
        <LastUpdated
          publishedAt={data.publishedAt}
          updatedAt={data.updatedAt}
          readingMinutes={readingMinutes(body)}
        />
      </div>

      <div class="mt-4">
        <QuickAnswer text={data.quickAnswer} />
      </div>

      {data.testedOn ? (
        <TestedOn testedOn={data.testedOn} />
      ) : data.type === 'explainer' ? (
        <p class="mt-3 text-sm text-ink-soft" data-research-note>
          Researched explainer. Supporting documentation and research are linked in the
          article.
        </p>
      ) : null}
      {data.affiliates.length > 0 && <AffiliateDisclosure />}

      <AdSlot position="after-answer" />

      {data.heroImage && (
        <figure class="my-6" data-pagefind-ignore data-article-art data-editorial-art>
          <Picture
            src={data.heroImage}
            alt={data.heroAlt ?? ''}
            widths={[480, 800, 1200]}
            width={1200}
            height={750}
            fit="cover"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            quality={78}
            sizes="(min-width: 1024px) 672px, 94vw"
            loading="eager"
            fetchpriority="high"
            class="illustration-frame aspect-[8/5] w-full object-cover"
          />
          <figcaption class="mt-2 text-right text-xs text-ink-faint">
            Editorial illustration
          </figcaption>
        </figure>
      )}

      <div class="lg:hidden">
        <Toc headings={headings} collapsed={true} />
      </div>

      <div class="prose prose-article dark:prose-invert prose-headings:font-display prose-headings:tracking-tight prose-a:text-brand-deep prose-code:before:content-none prose-code:after:content-none [&_:not(pre)>code]:rounded [&_:not(pre)>code]:bg-paper-sunk [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:font-medium prose-pre:rounded-card prose-pre:border prose-pre:border-rule prose-img:rounded-card prose-table:text-sm">
        <slot />
      </div>

      <AdSlot position="end-article" />

      <div data-pagefind-ignore>
        <Download items={data.downloads} />
        <ShareRow title={data.title} path={path} />
        <Helpful slug={post.id} />
      </div>
      <FAQ items={data.faq} />
      <div data-pagefind-ignore>
        <AuthorBox author={author} />
        <NewsletterForm source={`post:${post.id}`} />
        <RelatedPosts posts={related} />
        <PrevNext prev={prev} next={next} />
        <CopyCode />
        <ReaderBar />
      </div>
    </article>

    <aside class="hidden min-w-0 lg:block">
      <div class="sticky top-24 space-y-6">
        {pillar && (
          <div class="rounded-card border border-rule p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-soft">Topic</p>
            <a
              href={`/topics/${pillar.id}/`}
              class="font-display font-semibold no-underline"
            >
              {pillar.data.name}
            </a>
            <p class="mt-1 text-sm text-ink-soft">{pillar.data.description}</p>
          </div>
        )}
        <div class="hidden lg:block">
          <Toc headings={headings} />
        </div>
        <AdSlot position="sidebar" />
      </div>
    </aside>
  </div>
</BaseLayout>
