---

<button
  type="button"
  id="theme-toggle"
  class="flex items-center justify-center rounded-pill border border-rule px-2.5 py-1.5 text-ink-soft transition-colors hover:bg-paper-sunk hover:text-ink"
  aria-label="Switch between light and dark"
>
  <svg aria-hidden="true" viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor">
    <path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1Zm0 1.5v11a5.5 5.5 0 0 1 0-11Z" />
  </svg>
</button>
<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches;
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('a2z-theme', next);
    } catch {
      // Private mode or blocked storage: the choice just does not persist.
    }
  });
</script>
