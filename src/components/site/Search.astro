---
/** Pagefind is generated after Astro and loaded when a reader searches. */
---

<noscript>
  <p class="mb-4 rounded-soft border border-rule p-4 text-ink-soft">
    Search needs JavaScript. Browse the topics below to find an article.
  </p>
</noscript>
<div id="search" class="min-h-[6rem]">
  <label for="search-input" class="block text-sm font-semibold">
    Search every guide
  </label>
  <input
    id="search-input"
    type="search"
    autocomplete="off"
    placeholder="n8n, custom domain, Excel…"
    class="mt-2 w-full rounded-pill border border-rule bg-paper px-4 py-2.5 text-base shadow-card"
  />
  <div id="search-results" class="mt-4" aria-live="polite"></div>
</div>
<script>
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const container = document.getElementById('search');
  const status = document.getElementById('search-results');
  const query = new URLSearchParams(location.search).get('q') ?? '';
  let booted = false;
  let attempts = 0;
  const initialChildren = container ? [...container.childNodes] : [];

  // Ambient types, not values: the base no-unused-vars rule reads the interface
  // members as unused bindings. Same blind spot the config disables no-undef for.
  /* eslint-disable no-unused-vars */
  declare global {
    interface Window {
      PagefindUI: new (options: Record<string, unknown>) => {
        triggerSearch: (query: string) => void;
      };
    }
  }
  /* eslint-enable no-unused-vars */

  async function boot() {
    if (booted || !input || !container) return;
    booted = true;
    if (!document.querySelector('link[data-search-styles]')) {
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = '/pagefind/pagefind-ui.css';
      css.dataset.searchStyles = '';
      document.head.appendChild(css);
    }
    if (status) status.textContent = 'Loading search…';
    try {
      // The generated IIFE installs a browser global, not named ESM exports.
      const bundle = `/pagefind/pagefind-ui.js${attempts++ ? `?retry=${attempts}` : ''}`;
      await import(/* @vite-ignore */ bundle);
      const value = input.value;
      container.replaceChildren();
      const ui = new window.PagefindUI({
        element: '#search',
        showSubResults: false,
        showImages: false,
        excerptLength: 25,
        resetStyles: false,
      });
      if (value) ui.triggerSearch(value);
      const search = container.querySelector<HTMLInputElement>(
        '.pagefind-ui__search-input',
      );
      search?.focus();
      search?.addEventListener('input', () => {
        const url = new URL(location.href);
        if (search.value) url.searchParams.set('q', search.value);
        else url.searchParams.delete('q');
        history.replaceState(null, '', url);
      });
    } catch {
      booted = false;
      container.replaceChildren(...initialChildren);
      if (status) {
        status.textContent =
          'Search could not load. Check your connection and try again, or browse a topic below.';
        const retry = document.createElement('button');
        retry.type = 'button';
        retry.className =
          'mt-3 block min-h-11 rounded-pill border border-rule px-4 py-2 font-semibold';
        retry.textContent = 'Retry search';
        retry.addEventListener('click', () => void boot());
        status.append(retry);
      }
    }
  }

  input?.addEventListener('focus', boot);
  input?.addEventListener('input', boot);
  if (input && query) {
    input.value = query;
    void boot();
  }
</script>
