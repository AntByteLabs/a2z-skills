---
interface Props {
  compact?: boolean;
  source?: string;
  magnet?: string;
}
const { compact = false, source = 'inline', magnet = '' } = Astro.props;
import { TURNSTILE_SITE_KEY } from '../../site';
// The env var is an override for previews; the committed key is the live one.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? TURNSTILE_SITE_KEY;
const id = `nl-${Math.random().toString(36).slice(2, 8)}`;
---

<form
  method="POST"
  action="/api/subscribe"
  class:list={[
    'not-prose',
    compact ? 'mt-3' : 'mt-5 rounded-card border border-rule bg-paper-sunk p-4 sm:p-5',
  ]}
  data-newsletter
>
  {!compact && (
    <p class="font-display text-base font-semibold sm:text-lg">
      Join the guide notification list
    </p>
  )}
  <label class="sr-only" for={id}>
    Email address
  </label>
  <div class="mt-2 flex flex-col gap-2 sm:flex-row">
    <input
      id={id}
      type="email"
      name="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder="you@example.com"
      class="min-w-0 flex-1 rounded-pill border border-rule bg-paper px-4 py-2.5 text-base"
    />
    <button
      type="submit"
      class="rounded-pill bg-brand-deep px-4 py-2.5 font-semibold text-paper transition-colors hover:bg-brand"
    >
      Subscribe
    </button>
  </div>
  <!-- Bots fill this; people never see it. -->
  <div aria-hidden="true" class="absolute h-0 w-0 overflow-hidden">
    <label for={`${id}-website`}>Website</label>
    <input
      id={`${id}-website`}
      type="text"
      name="website"
      tabindex="-1"
      autocomplete="off"
    />
  </div>
  <input type="hidden" name="path" value={Astro.url.pathname} />
  <input type="hidden" name="source" value={source} />
  <input type="hidden" name="magnet" value={magnet} />
  {siteKey && (
    <div
      class="max-w-full overflow-x-auto empty:hidden"
      data-turnstile
      data-sitekey={siteKey}
    ></div>
  )}
  <p class="mt-2 text-xs text-ink-faint">
    Email delivery is not active yet. No sharing or selling your address.
  </p>
  <p class="mt-2 hidden text-sm text-good" data-newsletter-ok>
    Your address is saved. No confirmation email is sent yet.
  </p>
  <p class="mt-2 hidden text-sm text-bad" data-newsletter-err>
    That did not go through. Try again?
  </p>
</form>
<script>
  // Progressive enhancement: the form posts normally without JavaScript.
  //
  // Turnstile is loaded on first interaction rather than on page load. A post
  // page carries two of these forms, so auto-rendering put two third-party
  // iframes on the busiest page type, for a widget almost nobody reaches. This
  // way the script is fetched once, by the person actually subscribing.
  //
  // Without JavaScript there is no token. The Worker only demands one when
  // TURNSTILE_SECRET is set, so until it is, a no-JS submission still works.
  let loading: Promise<void> | null = null;

  const loadTurnstile = () => {
    if (loading) return loading;
    loading = new Promise<void>((resolve, reject) => {
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error('turnstile failed to load'));
      document.head.append(s);
    });
    return loading;
  };

  const arm = async (form: HTMLFormElement) => {
    const slot = form.querySelector<HTMLElement>('[data-turnstile]');
    if (!slot || slot.dataset.ready) return;
    slot.dataset.ready = 'yes';
    try {
      await loadTurnstile();
      // @ts-expect-error injected by the Turnstile script
      window.turnstile.render(slot, { sitekey: slot.dataset.sitekey, size: 'flexible' });
    } catch {
      // Leave the form usable: the Worker decides whether a token is required.
      delete slot.dataset.ready;
    }
  };

  document.querySelectorAll('form[data-newsletter]').forEach((node) => {
    const form = node as HTMLFormElement;

    // One pointer or keyboard touch on the form is enough to start the fetch.
    form.addEventListener('focusin', () => void arm(form), { once: true });
    form.addEventListener('pointerdown', () => void arm(form), { once: true });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const ok = form.querySelector('[data-newsletter-ok]');
      const err = form.querySelector('[data-newsletter-err]');
      ok?.classList.add('hidden');
      err?.classList.add('hidden');
      await arm(form);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        // A solved widget cannot be reused, so clear it for the next attempt.
        // @ts-expect-error injected by the Turnstile script
        window.turnstile?.reset?.();
        ok?.classList.remove('hidden');
      } catch {
        err?.classList.remove('hidden');
      }
    });
  });
</script>
