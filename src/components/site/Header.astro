---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../../site';
import { getCollection } from 'astro:content';

const pillars = (await getCollection('pillars')).sort(
  (a, b) => a.data.order - b.data.order,
);
interface Props {
  activePillar?: string;
}
const { activePillar } = Astro.props;
const here = Astro.url.pathname;
const onPillar = (id: string) => activePillar === id || here === `/topics/${id}/`;
---

<header class="sticky top-0 z-40 border-b border-rule bg-paper/85 backdrop-blur-md">
  <div class="shell flex h-14 items-center gap-3">
    <a
      href="/"
      class="shrink-0 font-display text-base font-bold tracking-tight no-underline sm:text-lg"
    >
      {site.name}
    </a>

    <nav aria-label="Topics" class="hidden min-w-0 flex-1 lg:block">
      <ul class="flex items-center gap-1 text-sm">
        {pillars.map((p) => (
          <li>
            <a
              href={`/topics/${p.id}/`}
              aria-current={onPillar(p.id) ? 'page' : undefined}
              class:list={[
                'rounded-pill px-2.5 py-1.5 no-underline transition-colors',
                onPillar(p.id)
                  ? 'bg-brand-wash font-semibold text-brand-deep'
                  : 'text-ink-soft hover:bg-paper-sunk hover:text-ink',
              ]}
            >
              {p.data.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <details class="ml-auto lg:hidden" data-topic-menu>
      <summary class="flex min-h-11 cursor-pointer list-none items-center gap-1 rounded-pill px-3 text-sm font-semibold marker:hidden">
        Topics
        <svg
          aria-hidden="true"
          viewBox="0 0 16 16"
          class="h-3 w-3"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path d="m4 6 4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <nav
        aria-label="Mobile topics"
        class="absolute inset-x-0 top-full border-b border-rule bg-paper py-4 shadow-card"
      >
        <ul class="shell grid grid-cols-2 gap-2 sm:grid-cols-3">
          {pillars.map((p) => (
            <li class="min-w-0">
              <a
                href={`/topics/${p.id}/`}
                aria-current={onPillar(p.id) ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 items-center rounded-soft px-3 py-2 text-sm no-underline',
                  onPillar(p.id)
                    ? 'bg-brand-wash font-semibold text-brand-deep'
                    : 'text-ink-soft hover:bg-paper-sunk',
                ]}
              >
                {p.data.name}
              </a>
            </li>
          ))}
          <li class="col-span-full">
            <a
              href="/topics/"
              class="flex min-h-11 items-center px-3 py-2 text-sm font-semibold"
            >
              All topics
            </a>
          </li>
        </ul>
      </nav>
    </details>
    <div class="flex shrink-0 items-center gap-1.5 lg:ml-auto">
      <a
        href="/search/"
        class="flex items-center gap-1.5 rounded-pill border border-rule px-3 py-1.5 text-sm no-underline text-ink-soft transition-colors hover:bg-paper-sunk hover:text-ink"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 16 16"
          class="h-3.5 w-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="7" cy="7" r="4.5" />
          <path d="M10.5 10.5 14 14" stroke-linecap="round" />
        </svg>
        <span class="sr-only sm:not-sr-only">Search</span>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-topic-menu]');
  if (menu) {
    addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
  }
</script>
