---
import ThemeToggle from './ThemeToggle.astro';
import { getCollection } from 'astro:content';

const pillars = (await getCollection('pillars')).sort(
  (a, b) => a.data.order - b.data.order,
);
interface Props {
  activePillar?: string;
}
const { activePillar } = Astro.props;
const here = Astro.url.pathname;
const onPillar = (id: string) => activePillar === id || here === `/topics/${id}/`;
---

<header class="sticky top-0 z-40 border-b border-rule bg-paper/85 backdrop-blur-md">
  <div class="shell flex h-16 lg:h-20 items-center gap-3">
    <a
      href="/"
      class="shrink-0 font-display text-2xl font-bold tracking-tight no-underline text-ink sm:text-3xl"
    >
      A2Z <span class="text-brand-deep">Skills</span>
    </a>

    <nav aria-label="Main" class="hidden min-w-0 flex-1 lg:block">
      <ul class="flex items-center gap-5 pl-6 text-sm">
        {[
          ['Latest', '/#guides'],
          ['Topics', '/topics/'],
          ['Tested guides', '/#tested-guides'],
          ['About', '/about/'],
        ].map(([label, href]) => (
          <li>
            <a
              href={href}
              class="inline-flex min-h-11 items-center no-underline text-ink-soft hover:text-brand-deep hover:underline"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <form
      action="/search/"
      method="get"
      role="search"
      class="hidden min-w-0 items-center rounded-soft border border-rule lg:flex"
    >
      <label class="sr-only" for={here === '/' ? 'home-q-desktop' : 'nav-q'}>
        Search guides
      </label>
      <input
        id={here === '/' ? 'home-q-desktop' : 'nav-q'}
        name="q"
        type="search"
        placeholder="Search guides…"
        class="min-h-11 w-40 min-w-0 rounded-soft bg-paper px-3 text-base xl:w-48"
      />
      <button
        type="submit"
        aria-label="Search"
        class="flex h-11 w-11 items-center justify-center text-ink-soft hover:text-brand-deep"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 16 16"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <circle cx="7" cy="7" r="4.5" />
          <path d="M10.5 10.5 14 14" />
        </svg>
      </button>
    </form>
    <details class="ml-auto lg:hidden" data-topic-menu>
      <summary class="flex min-h-11 cursor-pointer list-none items-center gap-1 rounded-pill px-3 text-sm font-semibold marker:hidden">
        Topics
        <svg
          aria-hidden="true"
          viewBox="0 0 16 16"
          class="h-3 w-3"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path d="m4 6 4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <nav
        aria-label="Mobile topics"
        class="absolute inset-x-0 top-full border-b border-rule bg-paper py-4 shadow-card"
      >
        <ul class="shell grid grid-cols-2 gap-2 sm:grid-cols-3">
          {pillars.map((p) => (
            <li class="min-w-0">
              <a
                href={`/topics/${p.id}/`}
                aria-current={onPillar(p.id) ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 items-center rounded-soft px-3 py-2 text-sm no-underline',
                  onPillar(p.id)
                    ? 'bg-brand-wash font-semibold text-brand-deep'
                    : 'text-ink-soft hover:bg-paper-sunk',
                ]}
              >
                {p.data.name}
              </a>
            </li>
          ))}
          <li class="col-span-full">
            <a
              href="/topics/"
              class="flex min-h-11 items-center px-3 py-2 text-sm font-semibold"
            >
              All topics
            </a>
          </li>
        </ul>
      </nav>
    </details>
    <div class="flex shrink-0 items-center gap-1.5 lg:ml-auto">
      <a
        href="/search/"
        class="flex min-h-11 items-center gap-1.5 rounded-soft px-3 text-sm no-underline text-ink-soft transition-colors hover:bg-paper-sunk hover:text-ink lg:hidden"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 16 16"
          class="h-3.5 w-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="7" cy="7" r="4.5" />
          <path d="M10.5 10.5 14 14" stroke-linecap="round" />
        </svg>
        <span class="sr-only sm:not-sr-only">Search</span>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-topic-menu]');
  if (menu) {
    addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
  }
</script>
