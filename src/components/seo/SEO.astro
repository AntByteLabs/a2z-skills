---
import { site, absolute } from '../../site';

interface Props {
  title: string;
  description: string;
  /** Path with leading and trailing slash, e.g. /excel-xlookup-not-working/ */
  path: string;
  seoTitle?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
  ogType?: 'website' | 'article';
}

const {
  title,
  seoTitle,
  description,
  path,
  image,
  imageAlt,
  noindex = false,
  publishedAt,
  updatedAt,
  ogType = 'website',
} = Astro.props;

const SUFFIX = ` | ${site.name}`;
const base = seoTitle ?? title;
// Keep the brand suffix only while the whole title still fits in a SERP.
const docTitle =
  !base.includes(site.name) && (base + SUFFIX).length <= 60 ? base + SUFFIX : base;
const canonical = absolute(path);
const ogImage = image ?? absolute('/og/default.png');
const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<title>{docTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={base} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={imageAlt ?? `${base} — ${site.name}`} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_GB" />
{publishedAt && (
  <meta property="article:published_time" content={publishedAt.toISOString()} />
)}
{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={base} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt ?? `${base} — ${site.name}`} />

<link
  rel="alternate"
  type="application/rss+xml"
  title={`${site.name} — all posts`}
  href={absolute('/rss.xml')}
/>
