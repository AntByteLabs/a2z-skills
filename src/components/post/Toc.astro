---
import type { MarkdownHeading } from 'astro';
interface Props {
  headings: MarkdownHeading[];
  collapsed?: boolean;
}
const { headings, collapsed = false } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{items.length > 2 && (
  <nav
    class="not-prose my-6 rounded-card border border-rule"
    aria-label="On this page"
    data-pagefind-ignore
  >
    <details open={!collapsed} class="group" data-toc-details>
      <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 font-semibold marker:hidden">
        On this page
        <svg
          aria-hidden="true"
          viewBox="0 0 16 16"
          class="h-4 w-4 text-ink-faint group-open:rotate-180"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path d="m4 6 4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <ol class="space-y-1 border-t border-rule px-4 py-3 text-sm" data-toc>
        {items.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class="block py-1 text-ink-soft no-underline hover:underline"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </details>
  </nav>
)}
<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')];
  const byId = new Map<string, HTMLAnchorElement[]>();
  for (const link of links) {
    const id = decodeURIComponent(link.hash.slice(1));
    byId.set(id, [...(byId.get(id) ?? []), link]);
  }
  if (links.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((link) => {
            link.classList.remove('text-ink', 'font-semibold');
            link.removeAttribute('aria-current');
          });
          byId.get(entry.target.id)?.forEach((link) => {
            link.classList.add('text-ink', 'font-semibold');
            link.setAttribute('aria-current', 'location');
          });
        }
      },
      { rootMargin: '-72px 0px -65% 0px' },
    );
    byId.forEach((_, id) => {
      const heading = document.getElementById(id);
      if (heading) observer.observe(heading);
    });
  }
</script>
