---
import { formatDate } from '../../lib/format';
interface Props {
  testedOn: {
    date: Date;
    versions: Record<string, string>;
    device?: string;
    testedBy?: string;
  };
  author: string;
}
const { testedOn, author } = Astro.props;
const by = testedOn.testedBy ?? author;
---

<div class="not-prose mt-3 rounded-card border border-rule bg-paper-sunk p-3.5 text-sm">
  <p class="flex items-center gap-1.5 font-semibold">
    <svg
      aria-hidden="true"
      viewBox="0 0 14 14"
      class="h-4 w-4 text-good"
      fill="currentColor"
    >
      <path d="M5.4 10.5 1.9 7l1.3-1.3 2.2 2.2 5.4-5.4L12.1 3.8z" />
    </svg>
    Tested {formatDate(testedOn.date)} by {by}
  </p>
  <dl class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
    {Object.entries(testedOn.versions).map(([name, version]) => (
      <div class="flex items-baseline gap-1.5">
        <dt class="text-ink-faint">{name}</dt>
        <dd class="font-mono text-ink">{version}</dd>
      </div>
    ))}
    {testedOn.device && (
      <div class="flex items-baseline gap-1.5">
        <dt class="text-ink-faint">Device</dt>
        <dd>{testedOn.device}</dd>
      </div>
    )}
  </dl>
</div>
