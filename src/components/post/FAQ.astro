---
/**
 * Rendered as ordinary page content. No FAQPage markup: Google stopped
 * showing those rich results for most sites, so it is weight without benefit.
 */
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="my-8" aria-labelledby="faq">
    <h2 id="faq" class="font-display text-2xl font-semibold">
      Questions people also ask
    </h2>
    <dl class="mt-4 divide-y divide-rule">
      {items.map((item) => (
        <div class="py-3">
          <dt class="font-semibold">{item.q}</dt>
          <dd class="mt-1 text-ink-soft">{item.a}</dd>
        </div>
      ))}
    </dl>
  </section>
)}
