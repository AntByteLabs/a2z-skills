---
/** Real errors hit during testing. This is the section competitors never have. */
interface Props {
  title?: string;
}
const { title = 'What broke while testing' } = Astro.props;
---

<section class="not-prose my-8 rounded-card border border-rule bg-paper-sunk p-4">
  <h2 class="font-display text-lg font-semibold">{title}</h2>
  <div class="prose prose-sm mt-2 max-w-none dark:prose-invert">
    <slot />
  </div>
</section>
