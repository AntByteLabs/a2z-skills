---
interface Props {
  type?: 'note' | 'warning' | 'danger' | 'tip';
  title?: string;
}
const { type = 'note', title } = Astro.props;
const skin = {
  note: { border: 'border-brand', label: 'Note' },
  tip: { border: 'border-good', label: 'Tip' },
  warning: { border: 'border-warn', label: 'Careful' },
  danger: { border: 'border-bad', label: 'Do not skip' },
}[type];
---

<aside
  class={`not-prose my-6 rounded-card border border-l-4 border-rule ${skin.border} bg-paper-sunk p-4`}
>
  <p class="text-xs font-semibold uppercase tracking-wide text-ink-soft">
    {title ?? skin.label}
  </p>
  <div class="prose prose-sm mt-1 max-w-none dark:prose-invert">
    <slot />
  </div>
</aside>
