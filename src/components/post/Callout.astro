---
/**
 * An aside inside an article: a tip, a warning, a thing not to do.
 *
 * The label carries the meaning, in the type's own colour, and the surface is
 * tinted from the same hue. There is no thick coloured bar down the edge: it
 * is the house style of every documentation theme, and it leaves the box
 * itself as undifferentiated grey, which is why these were easy to skip.
 */
interface Props {
  type?: 'note' | 'warning' | 'danger' | 'tip';
  title?: string;
}
const { type = 'note', title } = Astro.props;

const skin = {
  note: { tone: 'callout-note', label: 'Note' },
  tip: { tone: 'callout-tip', label: 'Tip' },
  warning: { tone: 'callout-warn', label: 'Careful' },
  danger: { tone: 'callout-danger', label: 'Do not skip' },
}[type];
---

<aside class={`not-prose callout ${skin.tone}`}>
  <p class="callout-label">
    <span class="callout-dot" aria-hidden="true"></span>
    {title ?? skin.label}
  </p>
  <div class="callout-body prose prose-sm max-w-none dark:prose-invert">
    <slot />
  </div>
</aside>
