---
import type { CollectionEntry } from 'astro:content';
interface Props {
  pillar: CollectionEntry<'pillars'>;
  count: number;
}
const { pillar, count } = Astro.props;
---

<a
  href={`/topics/${pillar.id}/`}
  class="card-link group block overflow-hidden no-underline"
>
  <span
    aria-hidden="true"
    class="block h-1.5"
    style={`background:${pillar.data.accent}`}
  ></span>
  <span class="block p-4">
    <span class="flex flex-wrap items-center gap-2">
      <span class="font-display text-base font-semibold text-ink group-hover:text-brand-deep">
        {pillar.data.name}
      </span>
      <span class="pill">
        {count} {count === 1 ? 'guide' : 'guides'}
      </span>
    </span>
    <span class="mt-1.5 block text-sm text-ink-soft">{pillar.data.description}</span>
    <span class="mt-2.5 flex items-center gap-1 text-sm font-medium text-brand-deep">
      Browse
      <svg
        aria-hidden="true"
        viewBox="0 0 16 16"
        class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          d="M3 8h9M9 4.5 12.5 8 9 11.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </span>
  </span>
</a>
