---
import type { CollectionEntry } from 'astro:content';
interface Props {
  pillar: CollectionEntry<'pillars'>;
  count: number;
}
const { pillar, count } = Astro.props;
---

<a
  href={`/topics/${pillar.id}/`}
  class="card group flex items-start gap-3 p-3.5 no-underline transition-shadow hover:shadow-lift"
>
  <span
    aria-hidden="true"
    class="mt-0.5 h-8 w-1.5 shrink-0 rounded-pill"
    style={`background:${pillar.data.accent}`}
  ></span>
  <span class="min-w-0">
    <span class="flex flex-wrap items-baseline gap-x-2">
      <span class="font-display text-base font-semibold text-ink group-hover:text-brand-deep">
        {pillar.data.name}
      </span>
      <span class="pill">
        {count} {count === 1 ? 'guide' : 'guides'}
      </span>
    </span>
    <span class="mt-1 block line-clamp-2 text-sm text-ink-soft">
      {pillar.data.description}
    </span>
  </span>
</a>
