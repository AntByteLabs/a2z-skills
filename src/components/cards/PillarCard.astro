---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
interface Props {
  pillar: CollectionEntry<'pillars'>;
  count: number;
  image?: ImageMetadata;
}
const { pillar, count, image } = Astro.props;
---

<a
  href={`/topics/${pillar.id}/`}
  class="card-link group block overflow-hidden no-underline"
>
  {image && (
    <Picture
      src={image}
      alt=""
      widths={[320, 640]}
      width={640}
      height={360}
      fit="cover"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      sizes="(min-width: 1024px) 360px, (min-width: 640px) 46vw, 94vw"
      loading="lazy"
      class="aspect-video w-full object-cover"
      data-editorial-art
    />
  )}
  <span class="block p-5">
    <span class="flex flex-wrap items-center justify-between gap-2">
      <span class="font-display text-xl font-semibold text-ink group-hover:text-brand-deep">
        {pillar.data.name}
      </span>
      <span class="text-xs text-ink-soft">
        {count} {count === 1 ? 'article' : 'articles'}
      </span>
    </span>
    <span class="mt-2 block text-base leading-relaxed text-ink-soft">
      {pillar.data.description}
    </span>
  </span>
</a>
