---
import type { Post } from '../../lib/posts';
import { postPath } from '../../lib/posts';
import { formatDate, readingMinutes } from '../../lib/format';

interface Props {
  post: Post;
  showPillar?: boolean;
}
const { post, showPillar = false } = Astro.props;
const { data } = post;
const stamp = data.updatedAt ?? data.publishedAt;
---

<article class="group border-b border-rule py-3.5 last:border-b-0">
  <a href={postPath(post)} class="block no-underline">
    <h3 class="font-display text-base font-semibold text-ink group-hover:text-brand-deep sm:text-lg">
      {data.title}
    </h3>
    <p class="mt-1 line-clamp-2 text-sm text-ink-soft">{data.description}</p>
  </a>
  <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-faint">
    <span class="pill">{data.type}</span>
    {data.testedOn && (
      <span class="pill text-good">
        <svg aria-hidden="true" viewBox="0 0 12 12" class="h-3 w-3" fill="currentColor">
          <path d="M4.6 9 1.4 5.8l1.1-1.1 2.1 2.1 4.9-4.9 1.1 1.1z" />
        </svg>
        tested
      </span>
    )}
    {showPillar && (
      <a href={`/topics/${data.pillar}/`} class="no-underline hover:underline">
        {data.pillar}
      </a>
    )}
    <time datetime={stamp.toISOString()}>
      {data.updatedAt ? `updated ${formatDate(stamp)}` : formatDate(stamp)}
    </time>
    <span aria-hidden="true">·</span>
    <span>{readingMinutes(post.body ?? '')} min</span>
  </p>
</article>
